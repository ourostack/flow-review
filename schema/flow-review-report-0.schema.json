{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ourostack/flow-review/schema/flow-review-report-0.schema.json",
  "title": "flow-review-report/0",
  "type": "object",
  "required": [
    "schema",
    "tool",
    "startedAt",
    "ms",
    "summary",
    "table",
    "units",
    "attachments",
    "judges"
  ],
  "properties": {
    "schema": {
      "const": "flow-review-report/0"
    },
    "knownFailing": {
      "description": "The known-failing list the run read: its file, whether it is enforced, its entries, and, when the run judged it (unsharded, or a merge), how many still fail, and which pass now or no longer run (each also a failing known finding).",
      "type": "object",
      "properties": { "file": { "type": ["string", "null"] }, "enforce": { "type": "boolean" }, "entries": { "type": "integer" }, "judged": { "type": "boolean" }, "failing": { "type": "integer" }, "passes": { "type": "array", "items": { "type": "string" } }, "notRun": { "type": "array", "items": { "type": "string" } } }
    },
    "engines": {
      "description": "Per browser engine: its units, failing and advisory findings, findings by check, what it measures differently (gaps) and the flows that didn't run on it (notRun). Absent from reports before engines.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["units", "failures", "byCheck", "gaps", "notRun"],
        "properties": {
          "units": { "type": "integer" },
          "failures": { "type": "number" },
          "advisories": { "type": "number" },
          "byCheck": { "type": "object" },
          "gaps": { "type": "array", "items": { "type": "object", "required": ["check", "what", "instead"], "properties": { "check": { "type": "string" }, "what": { "type": "string" }, "instead": { "type": "string" } } } },
          "notRun": { "type": "array", "items": { "type": "object", "required": ["flow", "why"], "properties": { "flow": { "type": "string" }, "file": { "type": ["string", "null"] }, "why": { "type": "string" } } } }
        }
      }
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "startedAt": {
      "type": "string"
    },
    "finishedAt": {
      "type": "string"
    },
    "ms": {
      "type": "number"
    },
    "shard": {
      "type": [
        "string",
        "null"
      ]
    },
    "failOn": {
      "type": "string"
    },
    "exitCode": {
      "type": "integer"
    },
    "summary": {
      "type": "object",
      "required": [
        "flows",
        "units",
        "findings",
        "failures",
        "byCheck"
      ],
      "properties": {
        "flows": {
          "type": "integer"
        },
        "units": {
          "type": "integer"
        },
        "findings": {
          "type": "integer"
        },
        "failures": {
          "type": "integer"
        },
        "advisories": {
          "type": "integer",
          "description": "Advisory findings (unusedRoute): reported, never failures."
        },
        "byCheck": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/count"
          }
        }
      }
    },
    "table": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "flow",
          "side",
          "surface",
          "units",
          "checks"
        ],
        "properties": {
          "flow": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "side": {
            "enum": [
              "human",
              "agent"
            ]
          },
          "surface": {
            "type": "string"
          },
          "units": {
            "type": "integer"
          },
          "ms": {
            "type": "number"
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/count"
            }
          }
        }
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "flow",
          "surface",
          "cell",
          "ms"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "flow": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "surface": {
            "type": "string"
          },
          "cell": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/definitions/cell"
              }
            ]
          },
          "ms": {
            "type": "number"
          },
          "failures": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "timedOut": {
            "type": "boolean",
            "description": "The unit ran past timeouts.cellMs and was stopped."
          }
        }
      }
    },
    "moments": {
      "type": "array",
      "description": "Every empty, loading, error, first-run and success state met, and whether it holds its Moment.",
      "items": {
        "type": "object",
        "required": [
          "flow",
          "step",
          "cell",
          "kind",
          "selector",
          "hasMoment"
        ],
        "properties": {
          "flow": {
            "type": "string"
          },
          "step": {
            "type": "string"
          },
          "cell": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/definitions/cell"
              }
            ]
          },
          "kind": {
            "enum": [
              "empty",
              "loading",
              "error",
              "first-run",
              "success"
            ]
          },
          "selector": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "how": {
            "type": "string"
          },
          "hasMoment": {
            "type": "boolean"
          }
        }
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "judges": {
      "type": "array"
    },
    "timing": {
      "type": "object"
    },
    "evidence": {
      "type": "object",
      "description": "The pictures the run kept: failing findings' crops, then the key moments judge packets name, up to maxBytes (null: no cap). dropped counts what the cap left out; unjudgedMoments, the captures no packet named, which keep no picture.",
      "required": ["maxBytes", "bytes", "files", "dropped", "unjudgedMoments"],
      "properties": {
        "maxBytes": { "type": ["integer", "null"] },
        "bytes": { "type": "integer" },
        "files": { "type": "integer" },
        "dropped": {
          "type": "object",
          "required": ["evidence", "moments", "bytes"],
          "properties": { "evidence": { "type": "integer" }, "moments": { "type": "integer" }, "bytes": { "type": "integer" } }
        },
        "unjudgedMoments": { "type": "integer" }
      }
    },
    "captures": {
      "type": "array",
      "description": "Each capture step, with its picture (crop) when a judge packet names it and it fit under the evidence cap.",
      "items": {
        "type": "object",
        "required": [
          "flow",
          "step"
        ],
        "properties": {
          "flow": {
            "type": "string"
          },
          "step": {
            "type": "string"
          },
          "moment": {
            "type": "string"
          },
          "crop": {
            "type": "string"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "description": "merge only: how the shard reports covered the expected units.",
      "properties": {
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "duplicated": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unexpected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timedOut": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missingReports": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Report folders given to merge that hold no report.json (a cancelled shard)."
        },
        "mode": {
          "enum": [
            "gated",
            "strict"
          ]
        },
        "failing": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Units whose coverage fails the merge (exit 3)."
        },
        "advisory": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Units of advisory flows that were missing, duplicated or timed out: coverage findings only."
        }
      }
    }
  },
  "definitions": {
    "count": {
      "type": "object",
      "required": [
        "pass",
        "fail"
      ],
      "properties": {
        "pass": {
          "type": "integer"
        },
        "fail": {
          "type": "integer"
        },
        "advisory": {
          "type": "integer"
        },
        "ms": {
          "type": "number"
        }
      }
    },
    "cell": {
      "type": "object",
      "required": [
        "viewport",
        "theme",
        "reducedMotion"
      ],
      "properties": {
        "viewport": {
          "type": "string"
        },
        "theme": {
          "enum": [
            "light",
            "dark"
          ]
        },
        "reducedMotion": {
          "type": "boolean"
        },
        "engine": {
          "enum": [
            "chromium",
            "webkit",
            "msedge"
          ]
        }
      }
    }
  }
}
