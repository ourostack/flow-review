{
  "schema": "flow-review/0",
  "name": "Routes fixture: a step's route wins over its goto's",
  "app": { "start": "node test/fixtures/serve.mjs 5305 test/fixtures/routes", "url": "http://127.0.0.1:5305/" },
  "matrix": { "viewports": ["800x600"], "themes": ["light"], "reducedMotion": [true] },
  "steps": [
    { "id": "open", "goto": "/", "route": { "**/api/**": { "json": { "text": "Goto answer" } } } },
    { "id": "late", "waitFor": { "selector": "#late:has-text('Goto answer')", "ms": 5000 } },
    { "id": "step", "act": { "role": "button", "name": "Fetch now", "verb": "click" }, "route": { "**/api/now.json": { "json": { "text": "Step answer" } } }, "expect": { "text": "Step answer" } },
    { "id": "again", "act": { "role": "button", "name": "Fetch now", "verb": "click" } },
    { "id": "goto-answers", "waitFor": { "selector": "#now:has-text('Goto answer')", "ms": 5000 } }
  ],
  "checks": { "only": ["unusedRoute"] }
}
